#!/bin/sh
# Runs claude on the active tagteam account and, when the plugin asks for a
# switch, starts it again on the target account with --resume (or fresh when
# there was no conversation yet).

TAGTEAM_HOME=${TAGTEAM_HOME:-$HOME/.claude-accounts}
TAGTEAM_RUN="$$-$(date +%s)"
export TAGTEAM_HOME TAGTEAM_RUN
state="$TAGTEAM_HOME/state"
switch_file="$state/switch-$TAGTEAM_RUN"
run_file="$state/run-$TAGTEAM_RUN"
watcher=

stop_watcher() {
  if [ -n "$watcher" ]; then
    kill "$watcher" 2>/dev/null
    wait "$watcher" 2>/dev/null
    watcher=
  fi
}

cleanup() {
  stop_watcher
  rm -f "$run_file"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 143' TERM
# A handler, not '' : an ignored signal would stay ignored in claude too.
trap : INT

value() {
  sed -n "s/^$1=//p" "$switch_file" 2>/dev/null | head -n 1
}

# A real claude shows as claude (native) or node .../claude; the test stub as sh .../claude.
is_claude() {
  ps -o args= -p "$1" 2>/dev/null | awk '{
    for (i = 1; i <= 2 && i <= NF; i++) { n = $i; sub(".*/", "", n); if (n == "claude") found = 1 }
  } END { exit !found }'
}

nap=
pause() {
  sleep "$1" &
  nap=$!
  wait "$nap"
  nap=
}

# Only matters when claude doesn't exit by itself after the plugin asks it to,
# for example while it sits on the usage limit menu.
watch() {
  trap - EXIT
  trap '' INT
  trap '[ -n "$nap" ] && kill "$nap" 2>/dev/null; exit 0' TERM
  while [ ! -f "$switch_file" ]; do pause 1; done
  stall=${TAGTEAM_STALL:-30}
  case $stall in '' | *[!0-9]*) stall=30 ;; esac
  pause "$stall"
  for pid in $(pgrep -P "$$"); do
    is_claude "$pid" || continue
    kill -TERM "$pid" 2>/dev/null
    i=0
    while [ "$i" -lt 10 ] && kill -0 "$pid" 2>/dev/null; do pause 1; i=$((i + 1)); done
    if kill -0 "$pid" 2>/dev/null && is_claude "$pid"; then kill -KILL "$pid" 2>/dev/null; fi
  done
}

root=$TAGTEAM_HOME
while :; do case $root in ?*/) root=${root%/} ;; *) break ;; esac; done
accounts="$state/accounts"

die() {
  printf 'tagteam: %s\n' "$1" >&2
  exit "${2:-1}"
}

valid_label() {
  case $1 in state | [!abcdefghijklmnopqrstuvwxyz0123456789]* | *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) return 1 ;; esac
  [ -n "$1" ] && [ "${#1}" -le 32 ]
}

check_label() {
  valid_label "$1" || die 'labels are lowercase letters, digits and dashes, up to 32 characters, and not "state"' 2
}

# Records are the plugin's JSON.stringify(account, null, 2): one "key": value per line.
field() {
  sed -n -e 's/,$//' -e "s/^ *\"$2\": \"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$1" | head -n 1
}

active_label() {
  head -n 1 "$state/active" 2>/dev/null
}

# Mirrors assertUnderRoot in the plugin: exactly one label below the root.
under_root() {
  case $1 in "$root"/*) valid_label "${1#"$root"/}" ;; *) return 1 ;; esac
}

discard() {
  CLAUDE_CONFIG_DIR=$1 claude auth logout >/dev/null 2>&1
  rm -rf "$1"
}

cmd_add() {
  check_label "$1"
  dir="$root/$1"
  if [ -e "$dir" ] || [ -L "$dir" ] || [ -e "$accounts/$1.json" ]; then die "$1 already exists"; fi
  mkdir -p "$dir" || exit 1
  echo 'The browser signs in whichever claude.ai account it has open, so switch it first, or open the URL on another device.'
  if ! CLAUDE_CONFIG_DIR=$dir claude auth login || ! status=$(CLAUDE_CONFIG_DIR=$dir claude auth status --text); then
    discard "$dir"
    die "sign-in did not finish, so $1 was not added"
  fi
  email=$(printf '%s\n' "$status" | sed -n 's/^Email: //p' | head -n 1)
  if [ -n "$email" ]; then
    for f in "$accounts"/*.json; do
      if [ ! -f "$f" ] || [ "$(field "$f" email)" != "$email" ]; then continue; fi
      other=${f##*/}
      discard "$dir"
      die "Nothing added: that login is already ${other%.json}"
    done
  fi
  echo "Added $1 ($email). It's ready, with its usage, after the next time you start tagteam."
}

# One short prompt on the account. That claude loads tagteam and records the
# usage reading itself. Gives up after 60 seconds.
ping_account() {
  (
    trap 'kill "$s" 2>/dev/null; exit 0' TERM
    sleep 60 &
    s=$!
    wait "$s"
    for pid in $(pgrep -P "$$"); do is_claude "$pid" && kill -TERM "$pid" 2>/dev/null; done
  ) &
  dog=$!
  # From the state folder, so no project hooks, instructions or MCP servers load.
  cd "$state" || return 1
  CLAUDE_CONFIG_DIR=$1 TAGTEAM_REFRESH=1 claude -p --model haiku 'Reply with OK.' </dev/null >/dev/null 2>&1
  rc=$?
  kill "$dog" 2>/dev/null
  wait "$dog" 2>/dev/null
  return "$rc"
}

cmd_refresh() {
  trap 'exit 130' INT
  # A here-document, not a pipe, so each claude is a child of this shell, where ping_account's timer looks.
  rows=$(for f in "$accounts"/*.json; do
    [ -f "$f" ] || continue
    l=${f##*/}
    printf '%s|%s|%s|%s|%s\n' "$(field "$f" order)" "${l%.json}" "$(field "$f" excluded)" "$(field "$f" needsSignIn)" "$(field "$f" dir)"
  done | sort -t '|' -k1,1n -k2,2)
  total=0
  ok=0
  failed=
  while IFS='|' read -r _ l excluded signin dir; do
    [ -n "$l" ] || continue
    total=$((total + 1))
    if [ "$excluded" = true ] || [ "$signin" = true ]; then continue; fi
    if ping_account "$dir" < /dev/null; then ok=$((ok + 1)); else failed="$failed${failed:+, }$l"; fi
  done <<EOF
$rows
EOF
  [ "$total" -gt 0 ] && echo "Refreshed $ok of $total accounts.${failed:+ Failed: $failed.}"
  cmd_list
}

cmd_remove() {
  check_label "$1"
  rec="$accounts/$1.json"
  [ -f "$rec" ] || die "no account named $1"
  dir=$(field "$rec" dir)
  in_use "$dir" && die "$1 is in use by a running tagteam session. Switch that session to another account first."
  under_root "$dir" || die "refusing to touch $dir: not an account folder inside $root"
  printf 'Remove %s (%s)? [y/N] ' "$1" "$(field "$rec" email)"
  if [ -n "${TAGTEAM_CONFIRM-}" ]; then
    answer=$TAGTEAM_CONFIRM
  elif ! { read -r answer < /dev/tty; } 2>/dev/null; then
    answer=
  fi
  case $answer in y | Y | yes | Yes | YES) ;; *) echo 'Cancelled.'; exit 1 ;; esac
  CLAUDE_CONFIG_DIR=$dir claude auth logout >/dev/null ||
    echo "Sign-out failed. Sign out of that login at claude.ai if needed." >&2
  rm -rf "$dir" || die "could not delete $dir"
  rm -f "$rec"
  echo "Removed $1."
  [ "$(active_label)" = "$1" ] || return 0
  next=$(for f in "$accounts"/*.json; do
    [ -f "$f" ] || continue
    l=${f##*/}
    printf '%s|%s\n' "$(field "$f" order)" "${l%.json}"
  done | sort -t '|' -k1,1n -k2,2 | head -n 1 | cut -d '|' -f 2)
  if [ -n "$next" ]; then
    put "$state/active" "$next"
    put "$state/active-dir" "$(field "$accounts/$next.json" dir)"
    echo "tagteam now starts on $next."
  else
    rm -f "$state/active" "$state/active-dir"
    echo 'No accounts left for tagteam to start on.'
  fi
}

put() {
  printf '%s\n' "$2" > "$1.tmp-$$" && mv "$1.tmp-$$" "$1"
}

# A run-<id> file names the folder a launcher has claude open on and the launcher's pid.
in_use() {
  for f in "$state"/run-*; do
    case $f in *.tmp-*) continue ;; esac
    [ -f "$f" ] || continue
    [ "$(sed -n 's/^dir=//p' "$f" | head -n 1)" = "$1" ] || continue
    p=$(sed -n 's/^pid=//p' "$f" | head -n 1)
    case $p in '' | *[!0-9]*) continue ;; esac
    kill -0 "$p" 2>/dev/null && return 0
  done
  return 1
}

cmd_list() {
  active=$(active_label)
  for f in "$accounts"/*.json; do
    [ -f "$f" ] || continue
    l=${f##*/}
    printf '%s|%s|%s|%s\n' "$(field "$f" order)" "${l%.json}" "$(field "$f" excluded)" "$(field "$f" email)"
  done | sort -t '|' -k1,1n -k2,2 | {
    any=
    while IFS='|' read -r _ l excluded email; do
      any=1
      mark=' '
      [ "$l" = "$active" ] && mark='*'
      note=
      [ "$excluded" = true ] && note=' (excluded)'
      echo "$mark $l  $email$note"
    done
    if [ -n "$any" ]; then
      echo 'Usage and reset times: /tagteam status inside Claude.'
    else
      echo 'No accounts yet. Add one with: tagteam add <label>'
    fi
  }
}

# Only these first words are tagteam's; "tagteam -- add" sends add to claude.
case ${1-} in
  add | remove | delete)
    [ $# -eq 2 ] || die "usage: tagteam $1 <label>" 2
    if [ "$1" = add ]; then cmd_add "$2"; else cmd_remove "$2"; fi
    exit ;;
  list | refresh)
    [ $# -eq 1 ] || die "usage: tagteam $1" 2
    "cmd_$1"
    exit ;;
  --)
    case ${2-} in add | remove | delete | list | refresh) shift ;; esac ;;
esac

mkdir -p "$state" || exit 1
dir=$(head -n 1 "$state/active-dir" 2>/dev/null)
session=
handover=
label=

relaunch=
while :; do
  # Session-picking flags would override the --resume below, so a relaunch drops them.
  if [ -n "$relaunch" ]; then
    n=$#
    i=0
    while [ "$i" -lt "$n" ]; do
      a=$1
      shift
      i=$((i + 1))
      case $a in
        --)
          set -- "$@" "$a"
          while [ "$i" -lt "$n" ]; do set -- "$@" "$1"; shift; i=$((i + 1)); done ;;
        -c | --continue | --fork-session | --session-id=* | --resume=* | --from-pr=* | --teleport=*) ;;
        -r | --resume | --from-pr | --teleport | --session-id)
          # A bare -r/--resume eats the next non-flag word on purpose: claude reads it as the value.
          if [ "$i" -lt "$n" ]; then
            case $1 in -*) ;; *) shift; i=$((i + 1)) ;; esac
          fi ;;
        *) set -- "$@" "$a" ;;
      esac
    done
    relaunch=
  fi
  printf 'dir=%s\npid=%s\n' "$dir" "$$" > "$run_file.tmp-$$" && mv "$run_file.tmp-$$" "$run_file"
  watch &
  watcher=$!
  if [ -n "$dir" ]; then CLAUDE_CONFIG_DIR=$dir; export CLAUDE_CONFIG_DIR; else unset CLAUDE_CONFIG_DIR; fi
  started=$(date +%s)
  # The handover goes first: claude takes the first bare word as the prompt and
  # ignores the rest, so a prompt in the original args must not displace it.
  if [ -n "$session" ]; then
    claude --resume "$session" "$handover" "$@"
  else
    claude "$@"
  fi
  code=$?
  stop_watcher
  rm -f "$run_file"

  # A resume that fails at once with 1 (the conversation can't be found) gets one
  # fresh start instead. Other codes, like 130 from Ctrl-C, end the launcher as usual.
  if [ -n "$session" ] && [ "$code" -eq 1 ] && [ ! -f "$switch_file" ] && [ $(($(date +%s) - started)) -lt 10 ]; then
    printf 'tagteam: could not resume the conversation, starting a new one on %s\n' "${label:-$dir}" >&2
    session=
    handover=
    relaunch=1
    continue
  fi
  [ -f "$switch_file" ] || exit "$code"
  # Empty when the session had no conversation yet: start fresh on the target.
  session=$(value session)
  dir=$(value target_dir)
  if [ -z "$dir" ]; then
    printf 'tagteam: the switch request names no account folder, so claude was not restarted\n' >&2
    rm -f "$switch_file"
    exit 1
  fi
  handover=$(value handover)
  resume_at=$(value resume_at)
  label=$(value target_label)
  rm -f "$switch_file"
  case $resume_at in '' | *[!0-9]*) ;; *)
    now=$(date +%s)
    if [ "$resume_at" -gt "$now" ]; then
      printf 'tagteam: every account is at its limit, resuming at %s. Ctrl-C to quit.\n' \
        "$(date -r "$resume_at" 2>/dev/null || date -d "@$resume_at")" >&2
      trap '[ -n "$nap" ] && kill "$nap" 2>/dev/null; exit 130' INT
      pause $((resume_at - now))
      trap : INT
    fi ;;
  esac
  if [ -n "$session" ]; then verb=resuming; else verb='starting fresh'; fi
  relaunch=1
  printf 'tagteam: %s on %s\n' "$verb" "${label:-$dir}" >&2
done
