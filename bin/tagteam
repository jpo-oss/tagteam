#!/bin/sh
# Runs claude on the active tagteam account and, when the plugin asks for a
# switch, starts it again on the target account with --resume (or fresh when
# there was no conversation yet).

TAGTEAM_HOME=${TAGTEAM_HOME:-$HOME/.claude-accounts}
TAGTEAM_RUN="$$-$(date +%s)"
export TAGTEAM_HOME TAGTEAM_RUN
state="$TAGTEAM_HOME/state"
switch_file="$state/switch-$TAGTEAM_RUN"
run_file="$state/run-$TAGTEAM_RUN"
watcher=

stop_watcher() {
  if [ -n "$watcher" ]; then
    kill "$watcher" 2>/dev/null
    wait "$watcher" 2>/dev/null
    watcher=
  fi
}

cleanup() {
  stop_watcher
  rm -f "$run_file"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 143' TERM
# A handler, not '' : an ignored signal would stay ignored in claude too.
trap : INT

value() {
  sed -n "s/^$1=//p" "$switch_file" 2>/dev/null | head -n 1
}

# A real claude shows as claude (native) or node .../claude; the test stub as sh .../claude.
is_claude() {
  ps -o args= -p "$1" 2>/dev/null | awk '{
    for (i = 1; i <= 2 && i <= NF; i++) { n = $i; sub(".*/", "", n); if (n == "claude") found = 1 }
  } END { exit !found }'
}

nap=
pause() {
  sleep "$1" &
  nap=$!
  wait "$nap"
  nap=
}

# Only matters when claude doesn't exit by itself after the plugin asks it to,
# for example while it sits on the usage limit menu.
watch() {
  trap - EXIT
  trap '' INT
  trap '[ -n "$nap" ] && kill "$nap" 2>/dev/null; exit 0' TERM
  while [ ! -f "$switch_file" ]; do pause 1; done
  stall=$(value stall)
  case $stall in '' | *[!0-9]*) stall=${TAGTEAM_STALL:-30} ;; esac
  pause "$stall"
  for pid in $(pgrep -P "$$"); do
    is_claude "$pid" || continue
    kill -TERM "$pid" 2>/dev/null
    i=0
    while [ "$i" -lt 10 ] && kill -0 "$pid" 2>/dev/null; do pause 1; i=$((i + 1)); done
    if kill -0 "$pid" 2>/dev/null && is_claude "$pid"; then kill -KILL "$pid" 2>/dev/null; fi
  done
}

mkdir -p "$state" || exit 1
dir=$(head -n 1 "$state/active-dir" 2>/dev/null)
session=
handover=
label=

while :; do
  printf 'dir=%s\npid=%s\n' "$dir" "$$" > "$run_file.tmp-$$" && mv "$run_file.tmp-$$" "$run_file"
  watch &
  watcher=$!
  if [ -n "$dir" ]; then CLAUDE_CONFIG_DIR=$dir; export CLAUDE_CONFIG_DIR; else unset CLAUDE_CONFIG_DIR; fi
  started=$(date +%s)
  # The handover goes first: claude takes the first bare word as the prompt and
  # ignores the rest, so a prompt in the original args must not displace it.
  if [ -n "$session" ]; then
    claude --resume "$session" "$handover" "$@"
  else
    claude "$@"
  fi
  code=$?
  stop_watcher
  rm -f "$run_file"

  # A resume that fails at once with 1 (the conversation can't be found) gets one
  # fresh start instead. Other codes, like 130 from Ctrl-C, end the launcher as usual.
  if [ -n "$session" ] && [ "$code" -eq 1 ] && [ ! -f "$switch_file" ] && [ $(($(date +%s) - started)) -lt 10 ]; then
    printf 'tagteam: could not resume the conversation, starting a new one on %s\n' "${label:-$dir}" >&2
    session=
    handover=
    continue
  fi
  [ -f "$switch_file" ] || exit "$code"
  # Empty when the session had no conversation yet: start fresh on the target.
  session=$(value session)
  dir=$(value target_dir)
  if [ -z "$dir" ]; then
    printf 'tagteam: the switch request names no account folder, so claude was not restarted\n' >&2
    rm -f "$switch_file"
    exit 1
  fi
  handover=$(value handover)
  resume_at=$(value resume_at)
  label=$(value target_label)
  rm -f "$switch_file"
  case $resume_at in '' | *[!0-9]*) ;; *)
    now=$(date +%s)
    if [ "$resume_at" -gt "$now" ]; then
      printf 'tagteam: every account is at its limit, resuming at %s. Ctrl-C to quit.\n' \
        "$(date -r "$resume_at" 2>/dev/null || date -d "@$resume_at")" >&2
      trap '[ -n "$nap" ] && kill "$nap" 2>/dev/null; exit 130' INT
      pause $((resume_at - now))
      trap : INT
    fi ;;
  esac
  if [ -n "$session" ]; then verb=resuming; else verb='starting fresh'; fi
  printf 'tagteam: %s on %s\n' "$verb" "${label:-$dir}" >&2
done
